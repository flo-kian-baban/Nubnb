rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public listings: anyone can read, nobody can write from a browser.
    // All writes go through your API routes using the Admin SDK,
    // which bypasses these rules entirely.
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if false;
    }

    // Contact form submissions: written by the server only, never readable
    // from a browser. This is the PII.
    match /contact_submissions/{submissionId} {
      allow read, write: if false;
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
