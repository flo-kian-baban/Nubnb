rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Properties: no browser reads or writes them (dispatch 26). The public
    // pages and the property JSON are built on the server through the Admin
    // SDK, which bypasses these rules, and the admin reads and writes through
    // its routes. A browser read used to be allowed one listed document at a
    // time, and every document carries its Airbnb calendar link with a
    // secret key; the feed behind it carries each reservation's link and the
    // last digits of the guest's phone. No page has shipped the Firestore
    // browser SDK since dispatch 24 (checked again in dispatch 26), so the
    // collection is closed to browsers entirely. Unlisted properties (Kian's
    // ruling of 2026-10-03) are covered by the same refusal.
    match /properties/{propertyId} {
      allow read, write: if false;
    }

    // Contact form submissions: written by the server only, never readable
    // from a browser. This is the PII.
    match /contact_submissions/{submissionId} {
      allow read, write: if false;
    }

    // Cleaner cost logging: cleaner accounts, the code index, cost entries
    // and the one-time keys that stop a receipt being logged twice.
    // Server-only, through the Admin SDK, which bypasses these rules. Never
    // readable or writable from a browser: cleaner codes are stored readably
    // (the code is the `cleaner_codes` document ID, and each cleaner holds
    // their current code), so a browser read of either collection would hand
    // out working codes.
    //
    // These blocks add no protection on their own: rules are OR-combined, so
    // an `if false` here cannot cancel an `allow` elsewhere. The invariant is
    // that NO allow rule may ever match these paths. The catch-all below
    // already denies them.
    match /cleaners/{cleanerId} { allow read, write: if false; }
    match /cleaner_codes/{code} { allow read, write: if false; }
    match /cost_entries/{entryId} { allow read, write: if false; }
    match /cost_entry_submissions/{submissionId} { allow read, write: if false; }
    // Dispatch 20: what the model read from each receipt (evidence about the
    // model, kept apart from the entry), and the per-day reading counts.
    match /cost_entry_readings/{entryId} { allow read, write: if false; }
    match /receipt_reading_quota/{day} { allow read, write: if false; }
    // Dispatch 21: the name cleaners see for a property, keyed by property
    // ID. Kept off the world-readable property document because these may be
    // street addresses. Admins set it and cleaners read it through their own
    // authenticated routes only.
    match /property_cleaner_names/{propertyId} { allow read, write: if false; }
    // 2026-09-30: one record per PDF cost report exported, holding what the
    // PDF printed for each entry, so the ledger can say when a PDF a
    // co-owner holds no longer matches. Written and read by admin routes only.
    match /cost_report_exports/{exportId} { allow read, write: if false; }
    // Dispatch 22 (2026-09-30): the stored copy of every property's calendar,
    // the current one and the first of each day. Written by the scheduled
    // function and the admin refresh route, read by the admin availability
    // route. Never from a browser.
    match /availability_snapshots/{docId} { allow read, write: if false; }
    match /availability_days/{day} { allow read, write: if false; }
    // Dispatch 23B (2026-09-30): monthly statements. The working draft of
    // each property-month, the finished statements (their PDF bytes are in
    // Storage), each download link minted, and each property's co-owners,
    // statement months and default fee. Admin routes only; the co-owners'
    // names and emails never reach a browser that is not an admin's.
    match /monthly_report_drafts/{draftId} { allow read, write: if false; }
    match /monthly_reports/{reportId} { allow read, write: if false; }
    match /report_downloads/{downloadId} { allow read, write: if false; }
    match /property_management/{propertyId} { allow read, write: if false; }
    // Dispatch 24 (2026-10-03): which properties are unlisted (read by the
    // server, never by a browser), and one record per month ZIP an admin
    // downloaded.
    match /property_visibility/{propertyId} { allow read, write: if false; }
    match /month_downloads/{downloadId} { allow read, write: if false; }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
